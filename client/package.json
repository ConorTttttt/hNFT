{
  "name": "@p2p-art-marketplace/client",
  "version": "0.0.1",
  "description": "TypeScript client for the P2P Art Marketplace NFT hApp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@holochain/client": "0.21.0",
    "@msgpack/msgpack": "^3.0.0",
    "blakejs": "^1.2.1"
  },
  "devDependencies": {
    "@types/blakejs": "^1.1.3",
    "typescript": "^5.6.0"
  }
}
